+    // A dropped connection used to surface much later as "Archive appears to be corrupt".
+    // Retry the download a couple of times when the connection is what failed.
+    func downloadFileRetrying(from downloadURL: URL, attempts: Int = 3) async throws -> URL {
+        var attempt = 1
+        while true {
+            do {
+                return try await downloadFile(from: downloadURL)
+            } catch let error as URLError where attempt < attempts && [.networkConnectionLost, .timedOut, .notConnectedToInternet, .cannotConnectToHost].contains(error.code) {
+                debugLog("[DownloadAppOperation] download attempt \(attempt) failed (\(error.code.rawValue)), retrying")
+                attempt += 1
+                try await Task.sleep(nanoseconds: 2_000_000_000)
+            }
+        }
+    }
