+    /// A cached payload is reused only if it was copied completely and holds the same version as the bundle.
+    private static func isUsableCachedPayload(_ payloadURL: URL, for bundleURL: URL) -> Bool {
+        guard let cached = NSDictionary(contentsOf: payloadURL.appendingPathComponent("Info.plist")) else { return false }
+        guard let source = NSDictionary(contentsOf: bundleURL.appendingPathComponent("Info.plist")) else { return true }
+        for key in ["CFBundleShortVersionString", "CFBundleVersion"] {
+            if (cached[key] as? String) != (source[key] as? String) { return false }
+        }
+        return true
+    }
+
