-
+/// Copies the running SideStore bundle into the payload cache, with the bundle identifiers
+/// SideStore expects for itself (same steps as DatabaseManager.prepareDatabase).
+private func recacheRunningSelfBundle() -> (signature: String, bundle: ALTApplication)? {
+    guard let localAppBundle = ALTApplication(fileURL: Bundle.Info.activeBundleURL) else { return nil }
+    let altstoreAppID = StoreApp.altstoreAppID
+    var result: (signature: String, bundle: ALTApplication)?
+    FileManager.default.prepareTemporaryURL { temporaryFileURL in
+        do {
+            try FileManager.default.copyItem(at: localAppBundle.fileURL, to: temporaryFileURL)
+            guard let tempAppBundle = ALTApplication(fileURL: temporaryFileURL) else {
+                throw OperationError.invalidApp(reason: "Failed to read the copy of the running SideStore bundle")
+            }
+            try tempAppBundle.updateInfoPlist(with: [kCFBundleIdentifierKey as String: altstoreAppID])
+            for appExtension in tempAppBundle.appExtensions {
+                let originalBundleID = appExtension.bundleIdentifier.replacingOccurrences(of: localAppBundle.bundleIdentifier, with: altstoreAppID)
+                try appExtension.updateInfoPlist(with: [kCFBundleIdentifierKey as String: originalBundleID])
+            }
+            let (signature, targetFileURL) = try CacheAppOperation.cachePayload(for: temporaryFileURL)
+            if let bundle = ALTApplication(fileURL: targetFileURL) {
+                result = (signature, bundle)
+            }
+        } catch {
+            debugLog("[PipelineRunner] Failed to cache the running SideStore bundle: \(error)")
+        }
+    }
+    return result
+}
